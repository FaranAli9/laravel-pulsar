class {{name}} implements ShouldQueue, ShouldQueueAfterCommit
{
    use Queueable;

    public int $tries = 3;

    public function handle({{event}} $event): void
    {
        // Carry immutable IDs, scalars, DTOs, or Value Objects in events. Never Eloquent models.
        // Re-establish actor/tenant context, then authorize with the owning domain's Ability enum.
        Gate::authorize('replace-with-domain-ability', $event);

