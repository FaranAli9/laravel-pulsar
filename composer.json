{
    "name": "faran/pulsar",
    "description": "An opinionated Laravel architecture for building modular, domain-driven applications at scale",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-12",
        "laravel-13",
        "architecture",
        "laravel-architecture",
        "code-generator",
        "scaffolding",
        "modular-architecture",
        "clean-architecture",
        "domain-driven-design",
        "ddd",
        "service-layer",
        "vertical-slice",
        "multi-tenant",
        "saas",
        "scalable",
        "medium-scale",
        "enterprise",
        "artisan",
        "crud",
        "php"
    ],
    "homepage": "https://github.com/faran/pulsar",
    "bin": [
        "bin/pulsar"
    ],
    "support": {
        "source": "https://github.com/faran/pulsar",
        "issues": "https://github.com/faran/pulsar/issues"
    },
    "autoload": {
        "psr-4": {
            "Faran\\Pulsar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Faran Ali",
            "email": "faranaliahmed@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "pestphp/pest": "^4.4",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --debug",
        "lint": "pint --test",
        "test": "pest",
        "test:coverage": "pest --coverage --min=85"
    },
    "suggest": {
        "ext-pcov": "Required to run the test:coverage script locally."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
